<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Core palette -->
  <Color x:Key="PrimaryColor">#4F7DF3</Color>
  <Color x:Key="PrimaryDarkColor">#3B63D6</Color>
  <Color x:Key="AccentColor">#2DD4BF</Color>
  <Color x:Key="DangerColor">#E5484D</Color>
  <Color x:Key="SuccessColor">#30A46C</Color>
  <Color x:Key="WarnColor">#F5A524</Color>
  <Color x:Key="InfoColor">#0EA5E9</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

  <!-- Translucent variants for hover/active states on coloured surfaces -->
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#4F7DF3" Opacity="0.12" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#E5484D" Opacity="0.12" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#30A46C" Opacity="0.12" />
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#F5A524" Opacity="0.12" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#0EA5E9" Opacity="0.12" />

  <!-- Dark-surface accent shades used on the sidebar and hero cards -->
  <SolidColorBrush x:Key="SidebarActiveBrush" Color="#25334F" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1B2740" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="OnDarkMutedBrush" Color="#B6C2D6" />
  <SolidColorBrush x:Key="HeroBadgeBrush" Color="#24304A" />

  <!-- Focus ring -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#4F7DF3" Opacity="0.45" />

  <!-- Spacing scale -->
  <Thickness x:Key="SpaceXs">4,0,4,0</Thickness>
  <Thickness x:Key="SpaceSm">8,0,8,0</Thickness>
  <Thickness x:Key="SpaceMd">16,0,16,0</Thickness>
  <Thickness x:Key="SpaceLg">24,0,24,0</Thickness>

  <!-- Corner radii -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>

  <!-- Elevation -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#141A2A" Opacity="0.10" />
  <DropShadowEffect x:Key="CardShadowHover" BlurRadius="26" ShadowDepth="4" Direction="270" Color="#141A2A" Opacity="0.16" />
</ResourceDictionary>

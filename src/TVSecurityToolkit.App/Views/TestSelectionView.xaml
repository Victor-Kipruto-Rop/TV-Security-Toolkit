<UserControl x:Class="TVSecurityToolkit.App.Views.TestSelectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Test selection" Style="{StaticResource Title}" />
    <TextBlock DockPanel.Dock="Top" Text="Choose the checks to run. Nothing executes until you start a run on the execution page." Style="{StaticResource Subtitle}" Margin="0,0,0,6" />
    <WrapPanel DockPanel.Dock="Top">
      <Button Content="Select all" Command="{Binding SelectAllCommand}" />
      <Button Content="Select none" Command="{Binding SelectNoneCommand}" Style="{StaticResource SecondaryButton}" />
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" CommandParameter="{Binding}"
                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>
    <ListBox ItemsSource="{Binding Tests}" MinHeight="300">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
            <TextBlock><Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text="  -  " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>

<UserControl x:Class="TVSecurityToolkit.App.Views.FindingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Findings" Style="{StaticResource Title}" />
    <TextBlock DockPanel.Dock="Top" Text="Failed and errored tests, ordered by severity. Simulator results are not hardware evidence." Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
    <TextBox DockPanel.Dock="Bottom" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True"
             Height="190" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             Style="{StaticResource Mono}" Background="{StaticResource SurfaceSunkenBrush}" Margin="0,10,0,0" />
    <DataGrid ItemsSource="{Binding Findings}" SelectedItem="{Binding Selected, Mode=TwoWay}" MinHeight="300">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Finding ID" Binding="{Binding Id}" />
        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
        <DataGridTextColumn Header="Test" Binding="{Binding TestId}" />
        <DataGridTextColumn Header="Component" Binding="{Binding AffectedComponent}" />
        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>

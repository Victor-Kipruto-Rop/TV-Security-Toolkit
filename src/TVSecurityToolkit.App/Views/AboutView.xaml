<UserControl x:Class="TVSecurityToolkit.App.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding Name}" Style="{StaticResource Title}" />
    <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Margin="0,0,0,10" Style="{StaticResource Eyebrow}" />
    <Border Style="{StaticResource Panel}" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="600" />
    </Border>
  </StackPanel>
</UserControl>

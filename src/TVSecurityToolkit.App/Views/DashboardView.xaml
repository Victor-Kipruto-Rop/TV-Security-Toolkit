<UserControl x:Class="TVSecurityToolkit.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="ASSESSMENT OVERVIEW" Style="{StaticResource Eyebrow}" />
    <TextBlock Text="Dashboard" Style="{StaticResource Title}" />
    <TextBlock Text="Monitor your authorized TV security assessment from one workspace."
               Style="{StaticResource Subtitle}" Margin="0,0,0,24" />
    <Border Background="{StaticResource SidebarBrush}" CornerRadius="{StaticResource RadiusLg}" Padding="24"
            Margin="0,0,0,20">
      <Border.Effect><StaticResource ResourceKey="CardShadow" /></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="CURRENT TARGET" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
          <TextBlock Text="{Binding DeviceText}" Foreground="{StaticResource OnDarkBrush}" FontSize="21"
                     FontWeight="SemiBold" Margin="0,8,0,6" />
          <TextBlock Foreground="{StaticResource OnDarkMutedBrush}"><Run Text="Environment: " /><Run Text="{Binding EnvironmentText, Mode=OneWay}" /></TextBlock>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource HeroBadgeBrush}" CornerRadius="{StaticResource RadiusSm}"
                Padding="16,10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Ready for review" Foreground="{StaticResource OnDarkBrush}" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <TextBlock Text="RUN SUMMARY" Style="{StaticResource Eyebrow}" Margin="0,4,0,12" />
    <WrapPanel>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Total tests" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Total}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Passed" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Passed}" Style="{StaticResource MetricValue}" Foreground="{StaticResource SuccessBrush}" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Failed" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Failed}" Style="{StaticResource MetricValue}" Foreground="{StaticResource DangerBrush}" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Errors" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Errors}" Style="{StaticResource MetricValue}" Foreground="{StaticResource WarnBrush}" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Findings" Style="{StaticResource Muted}" /><TextBlock Text="{Binding Findings}" Style="{StaticResource MetricValue}" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Critical" Style="{StaticResource Muted}" /><TextBlock Text="{Binding CriticalFindings}" Style="{StaticResource MetricValue}" Foreground="{StaticResource DangerBrush}" /></StackPanel></Border>
    </WrapPanel>
    <Border Style="{StaticResource Panel}" Background="{StaticResource SurfaceSubtleBrush}" Margin="0,4,0,0" Effect="{x:Null}">
      <StackPanel>
        <TextBlock Text="Safety-first workflow" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Connect and discover a target, select only the checks you are authorized to run, then preserve the generated evidence and reports for review." TextWrapping="Wrap" Style="{StaticResource Muted}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

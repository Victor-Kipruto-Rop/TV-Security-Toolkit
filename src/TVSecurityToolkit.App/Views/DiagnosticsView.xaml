<UserControl x:Class="TVSecurityToolkit.App.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Diagnostics" Style="{StaticResource Title}" />
    <TextBlock DockPanel.Dock="Top" Text="Read-only probes; nothing here changes device state." Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
    <WrapPanel DockPanel.Dock="Top">
      <Button Content="Health check" Command="{Binding HealthCommand}" />
      <Button Content="Debug / diagnostic probes" Command="{Binding ProbeCommand}" Style="{StaticResource SecondaryButton}" />
    </WrapPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Margin="0,12,0,12" Padding="18">
      <StackPanel>
        <TextBlock Text="Transport security probe" Style="{StaticResource SectionTitle}" />
        <TextBlock Text="Checks an explicitly entered host against the configured minimum TLS version." Style="{StaticResource Muted}" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Authorized TLS host:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding TlsHost, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,10,0" />
          <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding TlsPort, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,10,0" />
          <Button Content="Check TLS" Command="{Binding TlsCommand}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBox DockPanel.Dock="Top" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MinHeight="300"
             Style="{StaticResource Mono}" VerticalScrollBarVisibility="Auto"
             Background="{StaticResource SurfaceSunkenBrush}" />
  </DockPanel>
</UserControl>

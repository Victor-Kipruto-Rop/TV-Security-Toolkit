<Window x:Class="TVSecurityToolkit.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TVSecurityToolkit.App.ViewModels"
        xmlns:views="clr-namespace:TVSecurityToolkit.App.Views"
        Title="TV Security Toolkit" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DeviceViewModel}"><views:DeviceView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TestSelectionViewModel}"><views:TestSelectionView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TestExecutionViewModel}"><views:TestExecutionView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><views:ResultsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FindingsViewModel}"><views:FindingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Authorized assessment workspace" Style="{StaticResource Muted}" />
      </Grid>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="248" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="18,24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="4,0,4,30">
            <TextBlock Text="TV" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="SECURITY TOOLKIT" Foreground="{StaticResource OnDarkBrush}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="Assessment console" Foreground="{StaticResource SidebarMutedBrush}" FontSize="12" Margin="0,5,0,0" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0"
                   Background="Transparent" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="NavRoot" Padding="13,11" Margin="0,0,0,4" CornerRadius="{StaticResource RadiusSm}"
                        Background="Transparent">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,12,0"
                             VerticalAlignment="Center" Opacity="0.55" />
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource SidebarTextBrush}" FontSize="14" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                               Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="{StaticResource SidebarActiveBrush}" />
                  </DataTrigger>
                  <Trigger SourceName="NavRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource WindowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ContentControl Content="{Binding CurrentViewModel}" Margin="32,28,32,32" />
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>

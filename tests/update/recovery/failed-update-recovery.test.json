{
  "title": "Device recovers after failed update",
  "severity": "high",
  "steps": [
    {
      "call": "apply_update",
      "args": {
        "package": "@corrupted/corrupted-firmware.pkg"
      },
      "expect": {
        "accepted": false,
        "reason": "hash_mismatch"
      }
    },
    {
      "call": "boot",
      "args": {},
      "expect": {
        "booted": true,
        "running_version": "1.4.0"
      }
    },
    {
      "call": "apply_update",
      "args": {
        "package": "@valid/valid-update.pkg"
      },
      "expect": {
        "accepted": true
      }
    }
  ]
}

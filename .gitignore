!reports/**/.gitkeep
evidence/**
!evidence/**/
!evidence/**/.gitkeep
logs/**
!logs/**/
!logs/**/.gitkeep

# Signing material must never be committed
*.pfx
*.p12
*.pem
*.key
*.pvk
*.cer

{
  "category": "usb",
  "group": "integrity",
  "tests": [
    {
      "id": "usb.integrity.usb-integrity",
      "title": "Altered USB package rejected",
      "severity": "high",
      "steps": [
        {
          "call": "apply_update",
          "args": {
            "package": "@corrupted/corrupted-firmware.pkg",
            "source": "usb"
          },
          "expect": {
            "accepted": false,
            "reason": "hash_mismatch"
          }
        }
      ]
    }
  ]
}
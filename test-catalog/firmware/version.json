{
  "category": "firmware",
  "group": "version",
  "tests": [
    {
      "id": "firmware.version.version-validation",
      "title": "Supported firmware version accepted",
      "severity": "medium",
      "steps": [
        {
          "call": "validate_version",
          "args": {
            "version": "1.4.0"
          },
          "expect": {
            "supported": true
          }
        }
      ]
    },
    {
      "id": "firmware.version.unsupported-version",
      "title": "Unsupported firmware version rejected",
      "severity": "medium",
      "steps": [
        {
          "call": "validate_version",
          "args": {
            "version": "0.9.0"
          },
          "expect": {
            "supported": false
          }
        }
      ]
    }
  ]
}
